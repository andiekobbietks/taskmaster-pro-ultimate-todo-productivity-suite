---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Navigation -->
  <nav
    class="sticky top-0 z-50 border-b border-slate-200 bg-white/80 backdrop-blur dark:border-slate-800 dark:bg-slate-950/80"
  >
    <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
      <a href="#" class="flex items-center gap-2 text-lg font-bold text-slate-900 dark:text-white">
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-brand-600 text-white">TM</span>
        TaskMaster Pro
      </a>
      <div class="hidden items-center gap-8 text-sm font-medium md:flex">
        <a href="#how-it-works" class="hover:text-brand-600">How it works</a>
        <a href="#platform" class="hover:text-brand-600">Platform</a>
        <a href="#security" class="hover:text-brand-600">Security</a>
        <a href="#faq" class="hover:text-brand-600">FAQ</a>
      </div>
      <a
        href="#demo"
        class="rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-brand-700"
      >
        Try the demo
      </a>
    </div>
  </nav>

  <!-- Hero -->
  <section id="demo" class="relative overflow-hidden bg-brand-50 py-20 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid gap-12 lg:grid-cols-2 lg:items-center">
        <div class="animate-fadeIn">
          <h1 class="text-4xl font-bold leading-tight text-slate-900 dark:text-white sm:text-5xl lg:text-6xl">
            The deadline-driven execution engine.
          </h1>
          <p class="mt-6 text-lg text-slate-600 dark:text-slate-300">
            TaskMaster Pro turns hackathons, grants, bug bounties and tenders into
            a zero-babysit calendar, an eligibility engine and a court-ready evidence
            dossier.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a
              href="#demo"
              class="rounded-md bg-brand-600 px-6 py-3 font-semibold text-white shadow-md hover:bg-brand-700"
            >
              Try it with a Devpost URL
            </a>
            <a
              href="/docs/marketing/whitepaper-modular-execution-engine.md"
              class="rounded-md border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
            >
              Read the whitepaper
            </a>
          </div>
        </div>

        <div class="animate-scaleIn rounded-xl bg-white p-6 shadow-lg dark:bg-slate-900">
          <label for="demo-url" class="block text-sm font-semibold text-slate-900 dark:text-white">
            Paste a Devpost URL
          </label>
          <div class="mt-2 flex gap-2">
            <input
              id="demo-url"
              type="url"
              placeholder="https://devpost.com/hackathons/..."
              class="flex-1 rounded-md border border-slate-300 px-4 py-2 text-sm focus:border-brand-600 focus:outline-none focus:ring-2 focus:ring-brand-200 dark:border-slate-700 dark:bg-slate-950"
            />
            <button
              id="demo-btn"
              class="rounded-md bg-brand-600 px-4 py-2 text-sm font-semibold text-white hover:bg-brand-700"
            >
              See my calendar
            </button>
          </div>
          <p class="mt-2 text-xs text-slate-500">
            No account required. This is a live preview against public data.
          </p>

          <div id="demo-result" class="mt-6 hidden rounded-lg border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-950">
            <div class="flex items-center gap-2">
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700">eligible</span>
              <span class="text-sm font-semibold text-slate-900 dark:text-white" id="demo-title">Amazon Developer Hackathon</span>
            </div>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">
              Deadline: <span class="font-mono">2026-10-23</span> · Prize: <span class="font-mono">$150,000</span>
            </p>
            <div class="mt-3 flex flex-wrap gap-2">
              <span class="rounded-md bg-brand-100 px-2 py-1 text-xs font-medium text-brand-800">Add to calendar</span>
              <span class="rounded-md bg-brand-100 px-2 py-1 text-xs font-medium text-brand-800">Evidence checklist</span>
              <span class="rounded-md bg-brand-100 px-2 py-1 text-xs font-medium text-brand-800">Eligibility details</span>
            </div>
          </div>
          <p id="demo-error" class="mt-4 hidden text-sm text-red-600">Please paste a valid Devpost URL.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Social proof bar -->
  <section class="border-b border-slate-200 bg-white py-8 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl px-6">
      <div class="grid grid-cols-2 gap-6 text-center md:grid-cols-4">
        <div>
          <p class="text-2xl font-bold text-brand-600">5</p>
          <p class="text-xs font-medium text-slate-500">Runtime dependencies</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-brand-600">21</p>
          <p class="text-xs font-medium text-slate-500">MCP tools</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-brand-600">374</p>
          <p class="text-xs font-medium text-slate-500">Passing tests</p>
        </div>
        <div>
          <p class="text-2xl font-bold text-brand-600">Open Core</p>
          <p class="text-xs font-medium text-slate-500">Self-hostable</p>
        </div>
      </div>
      <blockquote class="mt-8 text-center text-lg font-medium italic text-slate-700 dark:text-slate-300">
        “I stopped missing submission windows. My calendar now updates itself.”
      </blockquote>
    </div>
  </section>

  <!-- Why todo apps fail -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Why todo apps fail for time-sensitive work</h2>
      <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
        A generic task manager records <em>what</em> you decided to do. It does not:
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            "Discover new opportunities while you sleep.",
            "Parse eligibility rules and tell you No — students only.",
            "Subscribe your phone calendar to a live deadline feed.",
            "Archive the evidence you need if a dispute happens.",
          ].map((item) => (
            <li class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <p class="text-sm text-slate-700 dark:text-slate-300">{item}</p>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-center text-lg font-semibold text-slate-900 dark:text-white">
        TaskMaster Pro is not a better to-do list. It is a <span class="text-brand-600">time-sensitive execution engine</span>.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section id="how-it-works" class="bg-white py-20 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-center text-3xl font-bold text-slate-900 dark:text-white">How it works</h2>
      <div class="mt-12 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl bg-brand-50 p-6 dark:bg-slate-900">
          <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 1</p>
          <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">Ingest</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">
            Connect Devpost, MLH or import a WACZ web archive. The hourly cron pulls new
            competitions, prize changes and deadline updates into your private SQLite store.
          </p>
        </div>
        <div class="rounded-xl bg-brand-50 p-6 dark:bg-slate-900">
          <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 2</p>
          <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">Decide</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">
            The deterministic eligibility engine answers eligible, not eligible or needs
            review in milliseconds. No LLM hallucination, no guesswork.
          </p>
        </div>
        <div class="rounded-xl bg-brand-50 p-6 dark:bg-slate-900">
          <p class="text-sm font-bold uppercase tracking-wide text-brand-600">Step 3</p>
          <h3 class="mt-2 text-xl font-semibold text-slate-900 dark:text-white">Execute</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">
            One subscribed calendar keeps the deadline on your lock screen. Attachments +
            trash give a 30-day safety net. The dossier generator exports a timestamped PDF.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Platform model -->
  <section id="platform" class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">The platform model</h2>
      <p class="mt-4 max-w-3xl text-lg text-slate-600 dark:text-slate-300">
        TaskMaster Pro is built as a shared <strong>Core</strong> plus pluggable
        <strong>domain modules</strong>.
      </p>
      <div class="mt-10 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 dark:bg-slate-800">
            <tr>
              <th class="px-6 py-3 font-semibold text-slate-900 dark:text-white">Core</th>
              <th class="px-6 py-3 font-semibold text-slate-900 dark:text-white">Module 1: Hackathons</th>
              <th class="px-6 py-3 font-semibold text-slate-900 dark:text-white">Future modules</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            <tr>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Tasks, tags, search</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Devpost + WACZ ingest</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Grants & research funding</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Edge SQLite storage</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Eligibility engine</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Bug bounties</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Live iCalendar feed</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Evidence dossier (PDF)</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Enterprise tenders</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">Audit log + encryption</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">MLH / HackerEarth routes</td>
              <td class="px-6 py-4 text-slate-600 dark:text-slate-300">…and anything with a deadline</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="bg-white py-20 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Feature comparison</h2>
      <div class="mt-10 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
        <table class="w-full text-left text-sm">
          <thead class="bg-slate-100 dark:bg-slate-800">
            <tr>
              <th class="px-6 py-3 font-semibold text-slate-900 dark:text-white">Capability</th>
              <th class="px-6 py-3 font-semibold text-brand-600">TaskMaster Pro</th>
              <th class="px-6 py-3 font-semibold text-slate-500">Notion</th>
              <th class="px-6 py-3 font-semibold text-slate-500">Trello</th>
              <th class="px-6 py-3 font-semibold text-slate-500">Spreadsheet</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
            {
              [
                ["Auto-ingest deadlines", true, false, false, false],
                ["Eligibility rules engine", true, false, false, "manual"],
                ["Live calendar feed", true, "limited", false, false],
                ["WACZ web-archive evidence", true, false, false, false],
                ["Court-ready dossier export", true, false, false, false],
                ["MCP agent surface", true, false, false, false],
                ["Self-hostable / single-tenant", true, false, false, "maybe"],
              ].map(([cap, tmp, notion, trello, sheet]) => (
                <tr>
                  <td class="px-6 py-3 text-slate-700 dark:text-slate-300">{cap}</td>
                  <td class="px-6 py-3 font-semibold text-brand-600">{tmp === true ? "✓" : tmp}</td>
                  <td class="px-6 py-3 text-slate-500">{notion === true ? "✓" : notion}</td>
                  <td class="px-6 py-3 text-slate-500">{trello === true ? "✓" : trello}</td>
                  <td class="px-6 py-3 text-slate-500">{sheet === true ? "✓" : sheet}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="py-20">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Use cases</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">For solo hackers</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">
            Paste a URL. Know in 10 seconds if you can enter. Add the deadline to your
            iPhone calendar once. Never open the app again until you win.
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">For teams</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">
            Share one token-protected deployment. Every team member sees the same
            opportunities, eligibility verdicts and evidence attachments.
          </p>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-white">For organisers and lawyers</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">
            Generate a timestamped PDF dossier with WACZ hashes and email milestones for
            terms-of-service disputes or prize appeals.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Security -->
  <section id="security" class="bg-brand-50 py-20 dark:bg-slate-900">
    <div class="mx-auto max-w-6xl px-6">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Security and trust</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          [
            "Bearer-token gate on every /api/* route",
            "AES-256-GCM encryption for settings and credentials",
            "Immutable audit log for settings and credential changes",
            "Self-hosted fonts; no third-party scripts at page view",
            "Single-tenant by design — your data stays in your Durable Object",
          ].map((item) => (
            <li class="flex items-start gap-3 rounded-lg bg-white p-4 shadow-sm dark:bg-slate-950">
              <span class="text-brand-600">✓</span>
              <span class="text-sm text-slate-700 dark:text-slate-300">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pricing / CTA -->
  <section class="py-20">
    <div class="mx-auto max-w-4xl px-6 text-center">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">Open Core pricing</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div class="rounded-xl border border-slate-200 bg-white p-8 text-left shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">Core — free</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">Self-host on your own Cloudflare account.</p>
          <ul class="mt-6 space-y-2 text-sm text-slate-600 dark:text-slate-300">
            <li>✓ Basic task manager</li>
            <li>✓ SQLite edge storage</li>
            <li>✓ Simple calendar subscription</li>
            <li>✓ MCP tool surface</li>
            <li>✓ Auth, audit and encryption baseline</li>
          </ul>
        </div>
        <div class="rounded-xl border-2 border-brand-600 bg-white p-8 text-left shadow-md dark:bg-slate-900">
          <h3 class="text-xl font-semibold text-slate-900 dark:text-white">Pro — modular upgrades</h3>
          <p class="mt-2 text-slate-600 dark:text-slate-300">Pluggable operational intelligence.</p>
          <ul class="mt-6 space-y-2 text-sm text-slate-600 dark:text-slate-300">
            <li>✓ Automated Hackathon & Opportunity Engine</li>
            <li>✓ WACZ cryptographic archiving</li>
            <li>✓ Court-ready PDF Dossier Generator</li>
            <li>✓ Domain-specific eligibility rules</li>
            <li>✓ Agentic MCP workflows</li>
          </ul>
        </div>
      </div>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a
          href="#"
          class="rounded-md bg-brand-600 px-6 py-3 font-semibold text-white shadow-md hover:bg-brand-700"
        >
          Get the whitepaper
        </a>
        <a
          href="https://github.com/andiekobbie/taskmaster-pro-ultimate-todo-productivity-suite"
          class="rounded-md border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          View on GitHub
        </a>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="bg-white py-20 dark:bg-slate-950">
    <div class="mx-auto max-w-3xl px-6">
      <h2 class="text-3xl font-bold text-slate-900 dark:text-white">FAQ</h2>
      <dl class="mt-10 space-y-6">
        <div>
          <dt class="font-semibold text-slate-900 dark:text-white">Do I need a Cloudflare account?</dt>
          <dd class="mt-1 text-slate-600 dark:text-slate-300">
            Yes for self-hosting. The worker runs on Cloudflare Workers; the SQLite store lives inside a Durable Object.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-900 dark:text-white">Is my data shared with Devpost or MLH?</dt>
          <dd class="mt-1 text-slate-600 dark:text-slate-300">
            No. The importer calls their public APIs from your worker. Your competition list and attachments stay in your own database.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-900 dark:text-white">Can I add my own module?</dt>
          <dd class="mt-1 text-slate-600 dark:text-slate-300">
            Yes. The pattern is documented in <code class="rounded bg-slate-100 px-1 py-0.5 font-mono text-xs dark:bg-slate-800">docs/PLATFORM.md</code>.
          </dd>
        </div>
        <div>
          <dt class="font-semibold text-slate-900 dark:text-white">What if a deadline changes?</dt>
          <dd class="mt-1 text-slate-600 dark:text-slate-300">
            The hourly cron updates SQLite. Your subscribed calendar refreshes on its next background fetch.
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Footer -->
  <footer class="border-t border-slate-200 bg-slate-50 py-12 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto max-w-6xl px-6 text-center">
      <p class="text-sm text-slate-500">
        Built with <strong>AK Build</strong> and the <strong>Cloudflare VibeSDK</strong>. Open Core. Self-hostable. Beta.
      </p>
      <div class="mt-4 flex justify-center gap-6 text-sm text-slate-600 dark:text-slate-400">
        <a href="#" class="hover:text-brand-600">GitHub</a>
        <a href="#" class="hover:text-brand-600">Documentation</a>
        <a href="#" class="hover:text-brand-600">MCP reference</a>
        <a href="#" class="hover:text-brand-600">Changelog</a>
      </div>
    </div>
  </footer>

  <script>
    const input = document.getElementById("demo-url");
    const btn = document.getElementById("demo-btn");
    const result = document.getElementById("demo-result");
    const error = document.getElementById("demo-error");

    btn.addEventListener("click", () => {
      const url = input.value.trim();
      if (!url || !url.includes("devpost.com")) {
        result.classList.add("hidden");
        error.classList.remove("hidden");
        return;
      }
      error.classList.add("hidden");
      result.classList.remove("hidden");
    });

    input.addEventListener("keydown", (e) => {
      if (e.key === "Enter") btn.click();
    });
  </script>
</Layout>

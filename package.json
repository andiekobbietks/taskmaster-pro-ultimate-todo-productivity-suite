{
  "name": "taskmaster-pro",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css",
    "build:js": "esbuild src/app.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --loader:.jsx=jsx --outfile=public/assets/app.js",
    "build:css": "tailwindcss -i src/tailwind.css -o public/assets/app.css --config tailwind.config.cjs --minify",
    "dev": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "seed": "node scripts/seed.mjs",
    "seed:validate": "node scripts/validate-seed.mjs",
    "docs:readiness": "node docs/scripts/readiness.mjs",
    "test": "node --experimental-strip-types scripts/test-inprocess.mjs",
    "test:watch": "node --experimental-strip-types --watch scripts/test-inprocess.mjs"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.17"
  }
}

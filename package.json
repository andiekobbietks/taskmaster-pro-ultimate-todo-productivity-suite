{
  "name": "taskmaster-pro",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:js && npm run build:css && node scripts/build-docs.mjs",
    "build:js": "esbuild src/app.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --loader:.jsx=jsx --outfile=public/assets/app.js",
    "build:css": "tailwindcss -i src/tailwind.css -o public/assets/app.css --config tailwind.config.cjs --minify",
    "dev": "npm run build && npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy",
    "seed": "node scripts/seed.mjs",
    "seed:validate": "node scripts/validate-seed.mjs",
    "docs:readiness": "node docs/scripts/readiness.mjs",
    "test": "node --experimental-strip-types scripts/test-inprocess.mjs",
    "test:watch": "node --experimental-strip-types --watch scripts/test-inprocess.mjs",
    "test:routes": "node --experimental-strip-types scripts/test-bugfixes.mjs",
    "test:push": "node --experimental-strip-types scripts/test-push.mjs && node --experimental-strip-types scripts/test-vapid.mjs",
    "test:push:encryption": "node --experimental-strip-types scripts/test-push.mjs",
    "test:push:vapid": "node --experimental-strip-types scripts/test-vapid.mjs",
    "test:timezone": "node --experimental-strip-types scripts/test-timezone.mjs",
    "icons": "python scripts/make-icons.py",
    "vapid": "node scripts/make-vapid-keys.mjs",
    "test:ui": "python scripts/verify-ui.py",
    "storybook:build": "esbuild src/storybook.jsx --bundle --minify --format=iife --target=es2019 --jsx=automatic --loader:.jsx=jsx --outfile=public/assets/storybook.js",
    "storybook:serve": "npm run storybook:build && node scripts/mock-api.mjs 8821",
    "handbook": "python scripts/build-handbook.py"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "lucide-react": "^0.400.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "esbuild": "^0.28.2",
    "portless": "^0.15.8",
    "tailwindcss": "^3.4.17"
  }
}
